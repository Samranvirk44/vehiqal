rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.phone_number == '+923114642679'
        || request.auth.token.email == 'admin.vehiqal@gmail.com'
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        || (
          request.auth.token.email != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
        )
      );
    }

    match /cars/{carId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.sellerId == request.auth.uid
        && (!('status' in request.resource.data) || request.resource.data.status == 'active');
      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.sellerId == request.auth.uid
          && request.resource.data.sellerId == resource.data.sellerId
          && request.resource.data.status == resource.data.status
        );
      allow delete: if isAdmin();
    }

    match /bids/{bidId} {
      allow create: if signedIn()
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId != request.auth.uid;
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
        ));
      allow update: if isAdmin()
        || (signedIn() && resource.data.sellerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }
  }
}
